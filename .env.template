# PrevCarga Environment Variables Template
#
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit .env files with real credentials to version control.
#
# The .env file is loaded automatically by python-dotenv if installed,
# or you can export these variables in your shell before running the application.

# =============================================================================
# AWS Configuration
# =============================================================================

# AWS Access Key ID
# Required for S3 storage backend authentication
# Create credentials in AWS IAM Console: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your-access-key-id

# AWS Secret Access Key
# Keep this secret! Never share or commit to version control.
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS Region (optional, defaults to config file value)
# Brazilian region for PrevCarga: sa-east-1 (Sao Paulo)
AWS_DEFAULT_REGION=sa-east-1

# AWS Session Token (optional)
# Required only when using temporary credentials (STS)
# AWS_SESSION_TOKEN=your-session-token

# =============================================================================
# PrevCarga Configuration
# =============================================================================

# Storage configuration file path (optional)
# If not set, uses default: ./config/storage.yaml
# PREVCARGA_STORAGE_CONFIG=./config/storage.yaml

# Data directory for local storage (optional)
# Overrides base_path in config file when using environment variable expansion
# PREVCARGA_DATA_DIR=./data

# =============================================================================
# S3-Compatible Services (Optional)
# =============================================================================

# Custom S3 endpoint URL
# Use this for MinIO, LocalStack, or other S3-compatible services
# S3_ENDPOINT_URL=http://localhost:9000

# For MinIO with default credentials:
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# S3_ENDPOINT_URL=http://localhost:9000

# =============================================================================
# Development Settings (Optional)
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# Enable debug mode (more verbose output)
# DEBUG=false
